# ===========================================
# Secret Vault 환경 변수 설정
# ===========================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
# cp .env.example .env
# ===========================================

# 서버 설정
NODE_ENV=development
PORT=3000

# ===========================================
# 데이터베이스 (PostgreSQL)
# ===========================================
# Docker Compose용 설정
POSTGRES_DB=secret_vault
POSTGRES_USER=vault
POSTGRES_PASSWORD=your-secure-password-here

# 백엔드 연결 URL (Docker Compose 사용 시)
DATABASE_URL=postgres://vault:your-secure-password-here@db:5432/secret_vault

# 로컬 PostgreSQL 사용 시 (Docker 미사용):
# DATABASE_URL=postgres://your_username@localhost:5432/secret_vault

# ===========================================
# 암호화 키 (필수! 반드시 변경하세요)
# ===========================================
# 생성 명령어: openssl rand -hex 32
# 주의: 프로덕션에서 이 키를 잃어버리면 모든 시크릿을 복호화할 수 없습니다!
MASTER_ENCRYPTION_KEY=

# ===========================================
# JWT 인증 (필수! 반드시 변경하세요)
# ===========================================
# 생성 명령어: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# ===========================================
# CORS 설정
# ===========================================
# 프론트엔드 URL
CORS_ORIGIN=http://localhost:5173

# ===========================================
# 프론트엔드 설정
# ===========================================
VITE_API_URL=http://localhost:3000

# ===========================================
# SSO (OIDC) — 선택
# ===========================================
# OIDC_ISSUER + OIDC_CLIENT_SECRET + VAULT_PUBLIC_URL 이 모두 설정되면 SSO 활성화
# (이메일/패스워드 로그인은 계속 동작)
# OIDC_ISSUER=https://auth.datasee.co.kr/oidc
# 웹 SSO용 클라이언트 (confidential, authorization_code)
# OIDC_CLIENT_ID=secret-vault
# OIDC_CLIENT_SECRET=
# CLI SSO(device flow)용 public 클라이언트 — IdP에 별도로 등록 필요
# OIDC_CLI_CLIENT_ID=secret-vault-cli
# 이 vault 인스턴스의 외부 URL (OIDC redirect_uri 생성에 사용)
# VAULT_PUBLIC_URL=https://vault.example.com
