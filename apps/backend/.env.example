# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgres://vault_user:devpassword123@localhost:5432/secret_vault

# Encryption (32 bytes = 64 hex chars)
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# SSO (OIDC) — optional. Enabled only when OIDC_ISSUER + OIDC_CLIENT_SECRET +
# VAULT_PUBLIC_URL are all set; password login keeps working.
# OIDC_ISSUER=https://auth.datasee.co.kr/oidc
# OIDC_CLIENT_ID=secret-vault
# OIDC_CLIENT_SECRET=
# Public client for the CLI device flow (register separately at the IdP)
# OIDC_CLI_CLIENT_ID=secret-vault-cli
# External URL of this vault (used to build the OIDC redirect_uri)
# VAULT_PUBLIC_URL=https://vault.example.com
