{
  "manifest_version": 3,
  "name": "Secret Vault Autofill",
  "version": "1.0.0",
  "description": "Fill shared team credentials from your private Secret Vault",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Secret Vault"
  },
  "options_page": "options.html"
}
