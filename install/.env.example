# ===========================================
# Secret Vault Configuration
# ===========================================
# Copy this file to .env and configure:
#   cp .env.example .env
#
# Generate keys with:
#   openssl rand -hex 32
# ===========================================

# Database password (change this!)
POSTGRES_PASSWORD=your-secure-password-here

# Encryption key (REQUIRED - 64 character hex string)
# Generate: openssl rand -hex 32
# WARNING: If you lose this key, all secrets become unrecoverable!
MASTER_ENCRYPTION_KEY=

# JWT secrets (REQUIRED - 64 character hex strings)
# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# CORS origin (your frontend URL)
# For local: http://localhost
# For production: https://vault.yourdomain.com
CORS_ORIGIN=http://localhost

# Port to expose (default: 80)
PORT=80

# ===========================================
# SSO (OIDC) — optional
# ===========================================
# SSO is enabled only when OIDC_ISSUER, OIDC_CLIENT_SECRET and
# VAULT_PUBLIC_URL are all set. Password login keeps working.
# OIDC_ISSUER=https://auth.example.com/oidc
# OIDC_CLIENT_ID=secret-vault
# OIDC_CLIENT_SECRET=
# Public client id for the CLI device-flow login (register at the IdP)
# OIDC_CLI_CLIENT_ID=secret-vault-cli
# External URL of this vault (used for the OIDC redirect_uri)
# VAULT_PUBLIC_URL=https://vault.example.com
